{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unsub",
  "version": "0.4.2",
  "identifier": "io.github.halfwoods.unsub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Unsub",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: artwork: http://artwork.localhost https: http:",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:1420",
        "script-src": "'self' http://localhost:1420",
        "style-src": "'self' 'unsafe-inline' http://localhost:1420",
        "img-src": "'self' data: blob: artwork: http://artwork.localhost https: http:",
        "media-src": "'self' blob:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1420",
        "font-src": "'self' data:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-src": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQkQzMzY5NjAyMENCQTgKUldTb3l5QmdhVE85d082Ly9kaEJOUFpCU0pZaGtzVThOd2t6TnlZN1lyNmRZaXlCR2o2Tjc3OUoK",
      "endpoints": ["https://github.com/halfwoods/Unsub/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../scripts/entitlements.plist"
    },
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
