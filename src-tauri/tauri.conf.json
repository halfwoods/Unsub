{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unsub",
  "version": "0.1.0",
  "identifier": "io.github.halfwoods.unsub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Unsub",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE: run `pnpm tauri signer generate -w ~/.tauri/unsub.key`, then paste the contents of the .pub file here. Until then the app never looks for updates.",
      "endpoints": ["https://github.com/halfwoods/Unsub/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../scripts/entitlements.plist"
    },
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
