{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AntiStreaming",
  "version": "0.1.0",
  "identifier": "org.antistreaming.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "AntiStreaming",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 420,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "../scripts/entitlements.plist"
    },
    "copyright": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
