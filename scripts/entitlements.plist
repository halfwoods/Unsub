<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Hardened runtime blocks Apple Events unless asked for; the app drives Music to download
       purchased songs (see NSAppleEventsUsageDescription in src-tauri/Info.plist). -->
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <!-- Hardened runtime blocks microphone access unless asked for; the visualizer's "React to sound"
       listens through it when the user turns that on (see NSMicrophoneUsageDescription in
       src-tauri/Info.plist). -->
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
